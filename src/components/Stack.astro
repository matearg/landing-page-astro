---
interface Tech {
  name: string;
  description: string;
}

interface Props {
  tech: Tech[];
}

const { tech } = Astro.props;
---

<section
  id="stack"
  class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-center text-3xl font-bold pointer-events-none">
      Tecnologías
    </h2>
    <p
      class="mx-auto mt-3 max-w-xl text-center text-slate-600 dark:text-slate-400 pointer-events-none"
    >
      Un stack chico y moderno, sin piezas que no uses.
    </p>
    <ul class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        tech.map((item) => (
          <li class="stack-item opacity-0 rounded-lg border border-slate-200 bg-white p-5 text-center dark:border-slate-800 dark:bg-slate-900">
            <p class="text-lg font-semibold text-brand-600 dark:text-brand-400 pointer-events-none">
              {item.name}
            </p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400 pointer-events-none">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from "../scripts/gsap-setup";

  const items = gsap.utils.toArray<HTMLElement>(".stack-item");

  if (items.length) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.set(items, { y: 24 });
      gsap.to(items, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
        stagger: 0.12,
        scrollTrigger: {
          trigger: "#stack",
          start: "top 75%",
          end: "bottom 20%",
          toggleActions: "play reverse play reverse",
        },
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(items, { opacity: 1, y: 0 });
    });
  }
</script>
