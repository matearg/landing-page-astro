---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section id="hero" class="relative mx-auto max-w-5xl px-6 pt-24 pb-20 text-center">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-72 max-w-3xl bg-gradient-to-b from-brand-200/60 to-transparent blur-3xl dark:from-brand-600/20"
  >
  </div>
  <h1
    class="hero-title text-4xl font-bold tracking-tight sm:text-6xl pointer-events-none"
  >
    {title}
  </h1>
  <p
    class="hero-subtitle mx-auto mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-400 pointer-events-none"
  >
    {subtitle}
  </p>
  <div class="hero-cta mt-10 flex flex-wrap items-center justify-center gap-4">
    <a
      href="#cta"
      class="rounded-md bg-brand-600 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400"
    >
      Comenzar ahora
    </a>
    <a
      href="#features"
      class="rounded-md border border-slate-300 px-6 py-3 text-sm font-medium hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
    >
      Ver características <span aria-hidden="true">→</span>
    </a>
  </div>
  <div
    class="hero-visual mx-auto mt-16 max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-slate-950 text-left shadow-2xl shadow-brand-500/10 dark:border-slate-800"
    aria-hidden="true"
  >
    <div class="flex gap-1.5 border-b border-slate-800 px-4 py-3">
      <span class="size-3 rounded-full bg-slate-700"></span>
      <span class="size-3 rounded-full bg-slate-700"></span>
      <span class="size-3 rounded-full bg-slate-700"></span>
      <span class="ml-3 text-xs text-slate-500">Hero.astro</span>
    </div>
    <pre
      class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-slate-300"><code><span class="text-slate-500">---</span>
<span class="text-brand-400">const</span> {"{ title }"} = Astro.props;
<span class="text-slate-500">---</span>
<span class="text-slate-500">&lt;</span><span class="text-brand-200">h1</span><span class="text-slate-500">&gt;</span>{"{title}"}<span class="text-slate-500">&lt;/</span><span class="text-brand-200">h1</span><span class="text-slate-500">&gt;</span></code></pre>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../scripts/gsap-setup";

  const targets = gsap.utils.toArray<HTMLElement>(
    ".hero-title, .hero-subtitle, .hero-cta, .hero-visual",
  );

  if (targets.length) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.set(targets, { opacity: 0, y: 24 });

      // Hero is already in the viewport on load, so ScrollTrigger's onEnter never
      // fires for it (no "entering" transition happens). Play the entrance directly,
      // then use a separate trigger just to reverse/replay as the section leaves/re-enters view.
      const entrance = gsap.to(targets, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power2.out",
        stagger: 0.12,
      });

      ScrollTrigger.create({
        trigger: "#hero",
        start: "top top",
        end: "bottom top",
        onLeave: () => entrance.reverse(),
        onEnterBack: () => entrance.play(),
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(targets, { opacity: 1, y: 0 });
    });
  }
</script>
