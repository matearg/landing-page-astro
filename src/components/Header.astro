---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;

const links = [
  { href: "#features", label: "Características" },
  { href: "#how", label: "Cómo funciona" },
  { href: "#stack", label: "Tecnologías" },
  { href: "#faq", label: "FAQ" },
  { href: "#cta", label: "Empezar" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-900/80"
>
  <nav
    id="site-nav"
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
  >
    <a
      href="#hero"
      class="text-lg font-semibold"
      >{siteName}</a
    >
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema"
        aria-pressed="false"
        class="rounded-md border border-slate-200 p-2 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer"
      >
        <svg
          id="theme-toggle-sun"
          class="hidden size-5 dark:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
          ></path>
        </svg>
        <svg
          id="theme-toggle-moon"
          class="block size-5 dark:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646Z"
          ></path>
        </svg>
      </button>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-menu"
        class="relative size-9 rounded-md border border-slate-200 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer"
      >
        <span
          class="menu-bar absolute left-1/2 top-[13px] h-0.5 w-5 -translate-x-1/2 rounded bg-current"
        ></span>
        <span
          class="menu-bar absolute left-1/2 top-[21px] h-0.5 w-5 -translate-x-1/2 rounded bg-current"
        ></span>
      </button>
    </div>
  </nav>
</header>

<div
  id="site-menu"
  inert
  class="fixed inset-0 z-9 hidden flex-col items-center justify-center bg-white dark:bg-slate-900"
>
  <ul class="flex flex-col items-center gap-6 text-2xl font-semibold sm:text-3xl">
    {
      links.map((link) => (
        <li class="menu-item">
          <a
            href={link.href}
            data-section={link.href}
            class="block px-4 py-1 text-slate-500 hover:text-slate-900 aria-[current=true]:text-brand-600 dark:text-slate-400 dark:hover:text-white dark:aria-[current=true]:text-brand-400"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { gsap, ScrollTrigger } from "../scripts/gsap-setup";

  const header = document.getElementById("site-header");
  const nav = document.getElementById("site-nav");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const toggleBtn = document.getElementById("theme-toggle");
  const overlay = document.getElementById("theme-transition-overlay");

  const syncPressed = () =>
    toggleBtn?.setAttribute(
      "aria-pressed",
      String(document.documentElement.classList.contains("dark")),
    );
  syncPressed();

  toggleBtn?.addEventListener("click", () => {
    const goingDark = !document.documentElement.classList.contains("dark");
    const applyTheme = () => {
      document.documentElement.classList.toggle("dark", goingDark);
      localStorage.setItem("theme", goingDark ? "dark" : "light");
      syncPressed();
    };

    if (prefersReducedMotion || !overlay) {
      applyTheme();
      return;
    }

    const rect = toggleBtn.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const maxRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    overlay.style.backgroundColor = goingDark ? "#0f172a" : "#ffffff";
    const state = { r: 0 };
    const setClip = () => {
      overlay.style.clipPath = `circle(${state.r}px at ${x}px ${y}px)`;
    };

    gsap
      .timeline()
      .to(state, {
        r: maxRadius,
        duration: 0.5,
        ease: "power2.inOut",
        onUpdate: setClip,
        onComplete: applyTheme,
      })
      .to(state, {
        r: 0,
        duration: 0.5,
        ease: "power2.inOut",
        onUpdate: setClip,
      });
  });

  if (header && nav && !prefersReducedMotion) {
    gsap.set(nav, { paddingTop: "1rem", paddingBottom: "1rem" });

    ScrollTrigger.create({
      start: "top -24px",
      onEnter: () => {
        gsap.to(nav, {
          paddingTop: "0.6rem",
          paddingBottom: "0.6rem",
          duration: 0.3,
          ease: "power2.out",
        });
        gsap.to(header, {
          boxShadow: "0 4px 20px -8px rgb(0 0 0 / 0.15)",
          duration: 0.3,
          ease: "power2.out",
        });
      },
      onLeaveBack: () => {
        gsap.to(nav, {
          paddingTop: "1rem",
          paddingBottom: "1rem",
          duration: 0.3,
          ease: "power2.out",
        });
        gsap.to(header, {
          boxShadow: "0 0 0 0 rgb(0 0 0 / 0)",
          duration: 0.3,
          ease: "power2.out",
        });
      },
    });
  }
</script>

<script>
  import { gsap } from "../scripts/gsap-setup";

  const btn = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("site-menu");
  const bars = gsap.utils.toArray<HTMLElement>(".menu-bar");
  const items = gsap.utils.toArray<HTMLElement>(".menu-item");
  const links = gsap.utils.toArray<HTMLAnchorElement>("#site-menu a");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let open = false;

  const setBars = (isOpen: boolean, animate: boolean) => {
    const [top, bottom] = bars;
    const d = animate && !reduced ? 0.3 : 0;
    gsap.to(top, { y: isOpen ? 4 : 0, rotate: isOpen ? 45 : 0, duration: d });
    gsap.to(bottom, { y: isOpen ? -4 : 0, rotate: isOpen ? -45 : 0, duration: d });
  };

  const setOpen = (next: boolean) => {
    if (!btn || !menu || next === open) return;
    open = next;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.body.style.overflow = open ? "hidden" : "";
    document
      .querySelectorAll<HTMLElement>("main, footer")
      .forEach((el) => (el.inert = open));
    setBars(open, true);
    gsap.killTweensOf([menu, ...items]);

    if (open) {
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      menu.inert = false;
      links[0]?.focus({ preventScroll: true });
      if (reduced) return;
      const r = btn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const maxR = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );
      gsap.fromTo(
        menu,
        { clipPath: `circle(0px at ${x}px ${y}px)` },
        {
          clipPath: `circle(${maxR}px at ${x}px ${y}px)`,
          duration: 0.6,
          ease: "power3.inOut",
          clearProps: "clipPath",
        },
      );
      gsap.fromTo(
        items,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", stagger: 0.07, delay: 0.25 },
      );
    } else {
      menu.inert = true;
      const hide = () => {
        menu.classList.add("hidden");
        menu.classList.remove("flex");
      };
      if (reduced) return hide();
      gsap.to(menu, { opacity: 0, duration: 0.25, onComplete: () => {
        hide();
        gsap.set(menu, { clearProps: "opacity" });
      } });
    }
  };

  btn?.addEventListener("click", () => setOpen(!open));
  links.forEach((a) => a.addEventListener("click", () => setOpen(false)));
  window.addEventListener("keydown", (e) => {
    if (!open) return;
    if (e.key === "Escape") {
      setOpen(false);
      btn?.focus();
      return;
    }
    if (e.key !== "Tab") return;
    // Trap focus between the header controls and the menu links.
    const focusable = [
      ...document.querySelectorAll<HTMLElement>(
        "#site-header a, #site-header button",
      ),
      ...links,
    ];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Scroll-spy: mark the section currently in view.
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.dataset.section ?? ""))
    .filter((el): el is HTMLElement => !!el);
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) =>
          a.setAttribute(
            "aria-current",
            String(a.dataset.section === `#${entry.target.id}`),
          ),
        );
      });
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  targets.forEach((t) => spy.observe(t));
</script>
