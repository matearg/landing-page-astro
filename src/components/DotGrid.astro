<div
  id="dot-grid"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10"
>
  <div class="dots dots-base absolute inset-0"></div>
  <div class="dots dots-accent absolute inset-0"></div>
</div>

<style>
  .dots {
    background-size: 24px 24px;
  }
  .dots-base {
    background-image: radial-gradient(
      circle,
      var(--color-slate-300) 1.5px,
      transparent 1.5px
    );
  }
  :global(.dark) .dots-base {
    background-image: radial-gradient(
      circle,
      var(--color-slate-700) 1.5px,
      transparent 1.5px
    );
  }
  /* Same dots in the accent color, revealed only around the cursor. */
  .dots-accent {
    background-image: radial-gradient(
      circle,
      var(--color-brand-500) 2px,
      transparent 2px
    );
    --mask: radial-gradient(
      circle 160px at var(--mx, -999px) var(--my, -999px),
      #000 0%,
      transparent 100%
    );
    mask-image: var(--mask);
    -webkit-mask-image: var(--mask);
  }
  :global(.dark) .dots-accent {
    background-image: radial-gradient(
      circle,
      var(--color-brand-400) 2px,
      transparent 2px
    );
  }
</style>

<script>
  const grid = document.getElementById("dot-grid");
  const canHover = window.matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  ).matches;

  if (grid && canHover) {
    let frame = 0;
    let x = -999;
    let y = -999;
    const render = () => {
      grid.style.setProperty("--mx", `${x}px`);
      grid.style.setProperty("--my", `${y}px`);
      frame = 0;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    window.addEventListener("pointermove", (e) => {
      x = e.clientX;
      y = e.clientY;
      schedule();
    });
    document.documentElement.addEventListener("pointerleave", () => {
      x = y = -999;
      schedule();
    });
  }
</script>
